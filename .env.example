# ── PostgreSQL (required; use managed Postgres with pgvector in production) ──
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=marketlens
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Auth (required) ──
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Groq LLM (optional; omit for deterministic_fallback reports) ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── CORS (required in production; comma-separated frontend origins) ──
# Example: https://marketlens-ai.vercel.app,https://www.example.com
CORS_ALLOWED_ORIGINS=

# ── ML (optional) ──
ANOMALY_DETECTOR_FALLBACK=
